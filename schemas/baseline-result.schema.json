{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "caseId": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "enum": [
        "UPDATE_DATA",
        "REPAIR_ADAPTER",
        "RETRY_LATER",
        "NO_ACTION",
        "HUMAN_REVIEW"
      ]
    },
    "firstMaterialDivergence": {
      "type": "string",
      "minLength": 1
    },
    "failureOwner": {
      "type": "string",
      "minLength": 1
    },
    "evidenceUsed": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidenceRejected": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "affectedEntities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "affectedFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "SET_RECORD_FIELDS"
              },
              "file": {
                "type": "string",
                "minLength": 1
              },
              "recordId": {
                "type": "string",
                "minLength": 1
              },
              "assignments": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "field",
                    "value"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "kind",
              "file",
              "recordId",
              "assignments"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "REPLACE_TEXT"
              },
              "file": {
                "type": "string",
                "minLength": 1
              },
              "find": {
                "type": "string",
                "minLength": 1
              },
              "replace": {
                "type": "string"
              },
              "expectedCount": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "kind",
              "file",
              "find",
              "replace",
              "expectedCount"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "NO_MUTATION"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "reason"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "preservedInvariants": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unresolvedUncertainty": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "minimumInformationRequest": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "retryCondition": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "approvalLevel": {
      "type": "string",
      "enum": [
        "NONE",
        "SIMULATED_HUMAN"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "arm": {
      "type": "string",
      "const": "baseline"
    },
    "executedCommands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "caseId",
    "action",
    "firstMaterialDivergence",
    "failureOwner",
    "evidenceUsed",
    "evidenceRejected",
    "affectedEntities",
    "affectedFiles",
    "operations",
    "preservedInvariants",
    "unresolvedUncertainty",
    "minimumInformationRequest",
    "retryCondition",
    "approvalLevel",
    "summary",
    "arm",
    "executedCommands"
  ],
  "additionalProperties": false,
  "title": "baseline-result"
}
