{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "caseId": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "type": "string",
      "enum": [
        "CONFIRM",
        "REJECT",
        "ESCALATE"
      ]
    },
    "evidenceIds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "residualRisks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "caseId",
    "verdict",
    "evidenceIds",
    "violations",
    "residualRisks",
    "summary"
  ],
  "additionalProperties": false,
  "title": "challenger-verdict"
}
