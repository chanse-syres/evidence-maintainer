{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "caseId": {
      "type": "string",
      "minLength": 1
    },
    "firstMaterialDivergence": {
      "type": "string",
      "minLength": 1
    },
    "failureOwner": {
      "type": "string",
      "minLength": 1
    },
    "evidenceAssessments": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidenceId": {
            "type": "string",
            "minLength": 1
          },
          "factPath": {
            "type": "string",
            "pattern": "^(?:\\$|sourceId|observedAt|effectiveAt|authorityScope|subjectId|kind|status|contentType|schemaFingerprint|facts(?:\\.[A-Za-z0-9_-]+)+)$"
          },
          "disposition": {
            "type": "string",
            "enum": [
              "SUPPORT",
              "REJECT",
              "CONTEXT"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "evidenceId",
          "factPath",
          "disposition",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "affectedEntities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "affectedFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "preservedInvariants": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unresolvedUncertainty": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "enum": [
        "UPDATE_DATA",
        "REPAIR_ADAPTER",
        "RETRY_LATER",
        "NO_ACTION",
        "HUMAN_REVIEW"
      ]
    },
    "operations": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "SET_RECORD_FIELDS"
              },
              "file": {
                "type": "string",
                "minLength": 1
              },
              "recordId": {
                "type": "string",
                "minLength": 1
              },
              "assignments": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "field",
                    "value"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "kind",
              "file",
              "recordId",
              "assignments"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "REPLACE_TEXT"
              },
              "file": {
                "type": "string",
                "minLength": 1
              },
              "find": {
                "type": "string",
                "minLength": 1
              },
              "replace": {
                "type": "string"
              },
              "expectedCount": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "kind",
              "file",
              "find",
              "replace",
              "expectedCount"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "reviewRequest": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "subjectId": {
              "type": "string",
              "minLength": 1
            },
            "targetEvidenceId": {
              "type": "string",
              "minLength": 1
            },
            "requestedFactPaths": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^facts(?:\\.[A-Za-z0-9_-]+)+$"
              }
            }
          },
          "required": [
            "subjectId",
            "targetEvidenceId",
            "requestedFactPaths"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "retryPlan": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "notBefore": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "maxAttempts": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "escalateAfterAttempt": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "preserveRecordIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "agreementChecks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "leftEvidenceId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "leftFactPath": {
                    "type": "string",
                    "pattern": "^facts(?:\\.[A-Za-z0-9_-]+)+$"
                  },
                  "rightEvidenceId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "rightFactPath": {
                    "type": "string",
                    "pattern": "^facts(?:\\.[A-Za-z0-9_-]+)+$"
                  }
                },
                "required": [
                  "leftEvidenceId",
                  "leftFactPath",
                  "rightEvidenceId",
                  "rightFactPath"
                ],
                "additionalProperties": false
              }
            },
            "valueChecks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "evidenceId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "factPath": {
                    "type": "string",
                    "pattern": "^facts(?:\\.[A-Za-z0-9_-]+)+$"
                  },
                  "expectedValue": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  }
                },
                "required": [
                  "evidenceId",
                  "factPath",
                  "expectedValue"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "notBefore",
            "maxAttempts",
            "escalateAfterAttempt",
            "preserveRecordIds",
            "agreementChecks",
            "valueChecks"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "caseId",
    "firstMaterialDivergence",
    "failureOwner",
    "evidenceAssessments",
    "affectedEntities",
    "affectedFiles",
    "preservedInvariants",
    "unresolvedUncertainty",
    "summary",
    "action",
    "operations",
    "reviewRequest",
    "retryPlan"
  ],
  "additionalProperties": false,
  "title": "maintainer-proposal"
}
