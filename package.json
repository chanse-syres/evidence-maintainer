{
  "name": "evidence-maintainer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test \"tests/*.test.ts\"",
    "case": "node --experimental-strip-types scripts/run-case.ts",
    "evaluate": "node --experimental-strip-types scripts/evaluate.ts",
    "evaluation:combine": "node --experimental-strip-types scripts/combine-evaluations.ts",
    "demo": "node --experimental-strip-types scripts/generate-demo.ts",
    "schemas": "node --experimental-strip-types scripts/generate-schemas.ts",
    "cases": "node --experimental-strip-types scripts/generate-core-cases.ts",
    "holdout:cases": "node --experimental-strip-types scripts/generate-holdout-cases.ts",
    "holdout:v3:cases": "node --experimental-strip-types scripts/generate-holdout-v3-cases.ts",
    "holdout:v4:cases": "node --experimental-strip-types scripts/generate-holdout-v4-cases.ts",
    "fixtures": "node --experimental-strip-types scripts/generate-recorded-fixtures.ts",
    "submission:verify": "node --experimental-strip-types scripts/verify-submission.ts",
    "engine:verify": "npm run schemas && git diff --exit-code -- schemas && npm run lint && npm test && npm run build",
    "verify": "npm run lint && npm test && npm run demo && npm run build"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.1"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "typescript": "6.0.3"
  }
}
